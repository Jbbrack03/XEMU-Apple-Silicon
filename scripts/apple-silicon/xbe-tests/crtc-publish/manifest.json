{
  "id": "crtc-publish",
  "title": "Front-buffer publish policy oracle",
  "purpose": "Render three distinct VRAM surfaces (A=red back-buffer, B=green extra-buffer-0 with 1 marker draw, C=blue extra-buffer-1 with 3 marker draws) every frame, rebind A, then push NV097_FLIP_STALL. The captured front buffer reveals which surface the renderer's publish path chose: CRTC-pointed (A, expected for real-Xbox / GL / Metal+fallback=0) or fallback dominant-draw (C, expected for Metal+fallback=1).",
  "catalog_ref": "§H.7, §3b.4, §K.2, §H.5",
  "self_validation_tier": 1,
  "oracle_priority": ["real-xbox", "math-derived"],
  "duration_seconds": 6,
  "capture_at_flip_stall_ordinal": null,
  "non_deterministic_regions": [],
  "requires_flags": [
    "XEMU_DISPLAY_SCALE=1",
    "XEMU_METAL_HUD=0"
  ],
  "artifacts": {
    "capture_blob": {
      "xbox_path": "D:\\crtc-publish-capture.bin",
      "ftp_path": "/E/XBMC4Gamers/Apps/crtc-publish/crtc-publish-capture.bin",
      "format": "XOSS+raw-bgrx",
      "stride_bytes_per_row": 2560,
      "width": 640,
      "height": 480
    },
    "done_marker": {
      "xbox_path": "D:\\crtc-publish-done.txt",
      "ftp_path": "/E/XBMC4Gamers/Apps/crtc-publish/crtc-publish-done.txt"
    }
  },
  "additional_metal_recipes": [
    {
      "name": "fallback0",
      "env": {
        "XEMU_METAL_FRONT_FB_FALLBACK": "0"
      }
    }
  ],
  "expected_results": {
    "real-xbox/any/any": {
      "kind": "math-derived",
      "generator": "expected.py:default",
      "tolerance": "exact"
    },
    "gl/any/any": {
      "kind": "math-derived",
      "generator": "expected.py:default",
      "tolerance": "exact"
    },
    "metal/scale=1/msaa=0/fallback=0": {
      "kind": "math-derived",
      "generator": "expected.py:default",
      "tolerance": "exact"
    },
    "metal/scale=1/msaa=0/fallback=1": {
      "kind": "math-derived",
      "generator": "expected.py:metal_with_fallback",
      "tolerance": "exact"
    },
    "any/any/any": {
      "kind": "math-derived",
      "generator": "expected.py:default",
      "tolerance": "exact"
    }
  },
  "expected_fail_renderers": []
}
